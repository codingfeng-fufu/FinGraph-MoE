# LLM graph extraction.
# Copy this file to .env locally and fill in your own key.

DASHSCOPE_API_KEY=
LLM_GRAPH_MODEL=qwen-plus
LLM_GRAPH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_GRAPH_TIMEOUT_SECONDS=45

# Optional OpenAI-compatible fallback.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
